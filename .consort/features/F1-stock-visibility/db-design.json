{
  "feature_id": "F1-stock-visibility",
  "tables": [
    {
      "name": "stock_records",
      "columns": [
        {
          "name": "id",
          "type": "bigint generated always as identity",
          "nullable": false,
          "description": "Surrogate key"
        },
        {
          "name": "sku",
          "type": "text",
          "nullable": false,
          "description": "Stock keeping unit (PI2)"
        },
        {
          "name": "location",
          "type": "text",
          "nullable": false,
          "description": "Storage location (PI3)"
        },
        {
          "name": "quantity",
          "type": "integer",
          "nullable": false,
          "description": "On-hand quantity, >= 0 (PI4, PI5)"
        },
        {
          "name": "tracking_code",
          "type": "text",
          "nullable": true,
          "description": "Optional; absent renders as 'not tracked'"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "nullable": false,
          "default": "now()",
          "description": "Set on upsert update"
        }
      ],
      "primary_key": [
        "id"
      ],
      "unique_constraints": [
        [
          "sku",
          "location"
        ]
      ],
      "checks": [
        {
          "name": "ck_stock_records_quantity_non_negative",
          "expression": "quantity >= 0"
        }
      ],
      "indexes": [
        {
          "name": "ix_stock_records_location",
          "columns": [
            "location"
          ],
          "unique": false
        },
        {
          "name": "ix_stock_records_location_sku",
          "columns": [
            "location",
            "sku"
          ],
          "unique": false
        }
      ]
    }
  ],
  "schema_changes": [
    {
      "id": "SC1-create-stock-records",
      "story_id": "S1-file-stock",
      "kind": "create_table",
      "table": "stock_records",
      "detail": "Create stock_records with NOT NULL sku/location/quantity, nullable tracking_code, timestamps, identity PK.",
      "migration_note": "Initial revision; downgrade drops the table (reversible, PI7)."
    },
    {
      "id": "SC2-add-sku-location-unique",
      "story_id": "S1-file-stock",
      "kind": "add_constraint",
      "table": "stock_records",
      "detail": "UNIQUE uq_stock_records_sku_location (sku, location); ON CONFLICT target for the atomic upsert (PI1, PI6).",
      "migration_note": "Created in the same revision as SC1."
    },
    {
      "id": "SC3-add-quantity-check",
      "story_id": "S1-file-stock",
      "kind": "add_constraint",
      "table": "stock_records",
      "detail": "CHECK ck_stock_records_quantity_non_negative (quantity >= 0) (PI5).",
      "migration_note": "Created in the same revision as SC1."
    },
    {
      "id": "SC4-add-location-index",
      "story_id": "S1-file-stock",
      "kind": "add_index",
      "table": "stock_records",
      "detail": "btree ix_stock_records_location (location) for SELECT DISTINCT location ORDER BY location (AP1).",
      "migration_note": "Same revision; dropped on downgrade."
    },
    {
      "id": "SC5-add-location-sku-index",
      "story_id": "S2-stock-by-location-table",
      "kind": "add_index",
      "table": "stock_records",
      "detail": "btree ix_stock_records_location_sku (location, sku) for WHERE location = :loc ORDER BY location, sku (AP2).",
      "migration_note": "Additive revision, down_revision = S1 create revision; downgrade drops only the index, stock_records rows persist; upgrade head recreates it (PI8)."
    }
  ],
  "realizes_invariants": [
    "PI1-unique-sku-location",
    "PI2-not-null-sku",
    "PI3-not-null-location",
    "PI4-not-null-quantity",
    "PI5-check-quantity-non-negative",
    "PI6-upsert-atomic",
    "PI7-create-table-reversible",
    "PI8-location-sku-index-migration-reversible"
  ],
  "addresses_access_patterns": [
    "AP1-distinct-locations",
    "AP2-stock-by-location-filter"
  ]
}